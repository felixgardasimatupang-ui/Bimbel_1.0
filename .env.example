# ═══════════════════════════════════════════
# Bimbel One Platform — Environment Variables
# Copy this to .env.local and fill in values
# ═══════════════════════════════════════════

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bimbel_one"

# Session / Auth
SESSION_SECRET="change-this-to-a-random-64-character-string"

# App
NEXT_PUBLIC_APP_NAME="Bimbel One Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo credentials (override default passwords for seed data)
# DEMO_ADMIN_PASSWORD="Admin123!"
# DEMO_FINANCE_PASSWORD="Finance123!"
# DEMO_TUTOR_PASSWORD="Tutor123!"
# DEMO_BRANCH_ADMIN_PASSWORD="Branch123!"
# DEMO_SUPPORT_PASSWORD="Support123!"

# Optional: Rate Limiting (Redis)
# REDIS_URL="redis://localhost:6379"

# Optional: Object Storage (S3-compatible)
# STORAGE_ENDPOINT="https://s3.amazonaws.com"
# STORAGE_BUCKET="bimbel-one-files"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# Optional: WhatsApp Gateway
# WA_API_KEY=""
# WA_PHONE_NUMBER=""

# Optional: Email (SMTP)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# Optional: Payment Gateway
# PAYMENT_MERCHANT_ID=""
# PAYMENT_API_KEY=""
# PAYMENT_API_SECRET=""

# Optional: Sentry Error Tracking
# SENTRY_DSN="https://example@sentry.io/123"
# SENTRY_ORG="bimbel-one"
# SENTRY_PROJECT="bimbel-one-platform"
